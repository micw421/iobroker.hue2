{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": "./build/",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2022",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["build/**", "node_modules/**"]
}
